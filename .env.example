# Copy to .env.local (or edit .env.development) and adjust as needed.

# Use the real backend API (true) or the in-app mock services (false).
VITE_USE_API=true

# Base URL of the ASP.NET Core public API. REQUIRED when VITE_USE_API=true.
# There is no hardcoded default — a missing value surfaces a clear config error.
VITE_API_URL=http://localhost:5199/api/v1
